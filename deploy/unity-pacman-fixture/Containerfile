ARG UNITY_EDITOR_IMAGE
FROM ${UNITY_EDITOR_IMAGE}

ARG UNITY_CONTAINER_USER=root
USER root
WORKDIR /workspace
COPY pkg/unity-pacman ./pkg/unity-pacman
COPY tests/unity-pacman-fixture ./tests/unity-pacman-fixture
COPY deploy/unity-pacman-fixture/run-fixture.sh /usr/local/bin/run-unity-pacman-fixture
RUN chmod +x /usr/local/bin/run-unity-pacman-fixture \
    && chmod -R a+rwX /workspace/tests/unity-pacman-fixture

ENV UNITY_PROJECT_PATH=/workspace/tests/unity-pacman-fixture
USER ${UNITY_CONTAINER_USER}
ENTRYPOINT ["/usr/local/bin/run-unity-pacman-fixture"]
