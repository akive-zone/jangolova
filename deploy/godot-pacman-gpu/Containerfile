ARG GODOT_IMAGE=barichello/godot-ci:4.3
FROM ${GODOT_IMAGE}

WORKDIR /workspace
COPY pkg/godot-pacman ./pkg/godot-pacman
COPY tests/godot-pacman-fixture ./tests/godot-pacman-fixture
COPY deploy/godot-pacman-gpu/run-fixture.sh /usr/local/bin/run-godot-pacman-gpu

RUN mkdir -p tests/godot-pacman-fixture/addons \
    && cp -R pkg/godot-pacman/addons/jangolova_pacman tests/godot-pacman-fixture/addons/jangolova_pacman \
    && mkdir -p /workspace/artifacts \
    && chmod 0777 /workspace/artifacts \
    && chmod +x /usr/local/bin/run-godot-pacman-gpu \
    && if command -v apt-get >/dev/null 2>&1; then \
         apt-get update \
         && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends xvfb \
         && rm -rf /var/lib/apt/lists/*; \
       elif command -v apk >/dev/null 2>&1; then \
         apk add --no-cache xvfb; \
       fi

ENV GODOT_PROJECT_PATH=/workspace/tests/godot-pacman-fixture
ENV GODOT_DISPLAY_DRIVER=x11
ENV GODOT_RENDERING_METHOD=gl_compatibility
ENV GODOT_RENDERING_DRIVER=opengl3
ENV GODOT_SCREEN_WIDTH=1280
ENV GODOT_SCREEN_HEIGHT=720
ENV GODOT_USE_XVFB=1
ENV JANGOLOVA_PACMAN_TOKEN=
ENV JANGOLOVA_PACMAN_PORT=8090
ENV JANGOLOVA_ARTIFACT_DIR=/workspace/artifacts
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics,display,video

EXPOSE 8090/tcp
VOLUME ["/workspace/artifacts"]

ENTRYPOINT ["/usr/local/bin/run-godot-pacman-gpu"]
