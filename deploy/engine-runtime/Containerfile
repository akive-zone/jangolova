FROM golang:1.26-bookworm AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY adapters ./adapters
COPY internal ./internal
RUN CGO_ENABLED=0 go build -o /out/jangolova ./cmd/jangolova

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        chromium \
        curl \
        fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /out/jangolova /usr/local/bin/jangolova

ENTRYPOINT ["jangolova"]
CMD ["serve-engine-provider"]
