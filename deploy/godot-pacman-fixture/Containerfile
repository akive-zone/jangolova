ARG GODOT_IMAGE=barichello/godot:4.3
FROM ${GODOT_IMAGE}

WORKDIR /workspace
COPY pkg/godot-pacman ./pkg/godot-pacman
COPY tests/godot-pacman-fixture ./tests/godot-pacman-fixture

RUN mkdir -p tests/godot-pacman-fixture/addons \
    && cp -R pkg/godot-pacman/addons/jangolova_pacman tests/godot-pacman-fixture/addons/jangolova_pacman

ENV GODOT_PROJECT_PATH=/workspace/tests/godot-pacman-fixture
ENV JANGOLOVA_PACMAN_TOKEN=
ENV JANGOLOVA_PACMAN_PORT=8090

ENTRYPOINT ["godot", "--headless", "--path", "/workspace/tests/godot-pacman-fixture", "--editor", "--quit-after", "2"]
