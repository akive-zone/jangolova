ARG UE_BUILD_IMAGE
ARG UE_RUNTIME_IMAGE
FROM ${UE_BUILD_IMAGE} AS builder

ARG UE_ROOT=/opt/UnrealEngine
USER root
WORKDIR /workspace
COPY pkg/unreal-pacman ./pkg/unreal-pacman
COPY tests/unreal-pacman-fixture ./tests/unreal-pacman-fixture

RUN test -x "${UE_ROOT}/Engine/Build/BatchFiles/RunUAT.sh"
RUN "${UE_ROOT}/Engine/Build/BatchFiles/RunUAT.sh" BuildPlugin \
    -Plugin="/workspace/pkg/unreal-pacman/JangolovaPacman.uplugin" \
    -Package="/out/JangolovaPacman" \
    -Rocket \
    -TargetPlatforms=Linux \
    -utf8output
RUN "${UE_ROOT}/Engine/Binaries/ThirdParty/DotNet/10.0/linux-x64/dotnet" \
    "${UE_ROOT}/Engine/Binaries/DotNET/UnrealBuildTool/UnrealBuildTool.dll" \
    UnrealPacmanFixtureEditor Linux Development \
    -Project="/workspace/tests/unreal-pacman-fixture/UnrealPacmanFixture.uproject" \
    -NoUBTMakefiles \
    -utf8output
RUN chown -R ue4:ue4 /workspace /out
USER ue4
RUN "${UE_ROOT}/Engine/Build/BatchFiles/RunUAT.sh" BuildCookRun \
    -project="/workspace/tests/unreal-pacman-fixture/UnrealPacmanFixture.uproject" \
    -noP4 \
    -skipbuildeditor \
    -build \
    -cook \
    -stage \
    -pak \
    -prereqs \
    -archive \
    -archivedirectory="/out/UnrealPacmanFixture" \
    -platform=Linux \
    -clientconfig=Shipping \
    -utf8output

FROM ${UE_RUNTIME_IMAGE} AS runtime

ARG UE_RUNTIME_USER=root
USER root
WORKDIR /opt/unreal-pacman-fixture
COPY --from=builder /out/UnrealPacmanFixture ./
COPY deploy/unreal-pacman-gpu/run-fixture.sh /usr/local/bin/run-unreal-pacman-gpu

RUN chmod +x /usr/local/bin/run-unreal-pacman-gpu \
    && mkdir -p /workspace/artifacts \
    && chmod 0777 /workspace/artifacts \
    && if command -v apt-get >/dev/null 2>&1; then \
         apt-get update \
         && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends xvfb \
         && rm -rf /var/lib/apt/lists/*; \
       elif command -v apk >/dev/null 2>&1; then \
         apk add --no-cache xvfb; \
       fi

ENV UNREAL_FIXTURE_EXECUTABLE=/opt/unreal-pacman-fixture/Linux/UnrealPacmanFixture/Binaries/Linux/UnrealPacmanFixture-Linux-Shipping
ENV UNREAL_SCREEN_WIDTH=1280
ENV UNREAL_SCREEN_HEIGHT=720
ENV UNREAL_USE_XVFB=1
ENV UNREAL_RENDER_API=vulkan
ENV UNREAL_ARTIFACT_DIR=/workspace/artifacts
ENV JANGOLOVA_PACMAN_TOKEN=
ENV JANGOLOVA_PACMAN_PORT=8090
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics,display,video

EXPOSE 8090/tcp
VOLUME ["/workspace/artifacts"]

USER ${UE_RUNTIME_USER}
ENTRYPOINT ["/usr/local/bin/run-unreal-pacman-gpu"]
