{
  "name": "jangolova-interaction-engines",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:browser-extension": "npm --prefix pkg/browser-ext run build",
    "build:macos-extension": "pkg/macos-ext/scripts/build-safari.sh",
    "compile:browser-extension": "npm --prefix pkg/browser-ext run compile",
    "generate:browser-extension-protocol": "node scripts/generate-browser-extension-protocol.mjs",
    "check:browser-extension-protocol": "node scripts/generate-browser-extension-protocol.mjs --check",
    "compile:threejs-pacman": "pkg/browser-ext/node_modules/.bin/tsc -p pkg/threejs-pacman/tsconfig.json --noEmit",
    "test:browser-worker": "node --test tests/browser-worker-contract-test.mjs",
    "test:cymonkey": "node --test tests/cymonkey-contract-test.mjs",
    "test:cymonkey:macos-helper": "swift test --package-path pkg/macos-cymonkey-helper && node --test tests/macos-cymonkey-helper-contract-test.mjs",
    "test:userscripts": "npm --prefix pkg/userscript-runtime test",
    "test:macos-extension": "swift test --package-path pkg/macos-ext && node --test tests/macos-extension-contract-test.mjs",
    "test:browser-extension": "node --test tests/browser-extension-system-contract-test.mjs tests/browser-extension-control-contract-test.mjs tests/outbound-control-client-test.mjs tests/browser-extension-protocol-compatibility-test.mjs",
    "test:xallet-spook": "node --test tests/xallet-spook-client-test.mjs",
    "test:threejs-pacman": "pkg/browser-ext/node_modules/.bin/tsc -p pkg/threejs-pacman/tsconfig.json && node --test tests/threejs-pacman-test.mjs",
    "test:cymonkey:live:cdp": "docker compose -f tests/docker/compose.yaml run --rm --entrypoint tests/docker/browser-interaction-smoke-test.sh engine-test",
    "test:cymonkey:live:bidi": "docker compose -f tests/docker/compose.yaml run --rm --entrypoint tests/docker/firefox-bidi-smoke-test.sh engine-test",
    "test:presentation-worker": "node --test tests/presentation-worker-contract-test.mjs",
    "test:unity-package": "node tests/unity-package-contract-test.mjs",
    "test:unity-pacman-package": "node tests/unity-pacman-package-contract-test.mjs",
    "test:unity-pacman-fixture": "node tests/unity-pacman-fixture-contract-test.mjs",
    "test:godot-pacman-fixture": "node tests/godot-pacman-fixture-contract-test.mjs",
    "test:godot-pacman-house": "node tests/godot-pacman-house-live-test.mjs",
    "test:pacman-gpu-fixtures": "node tests/pacman-gpu-fixture-contract-test.mjs",
    "test:unreal-pacman-package": "node tests/unreal-pacman-package-contract-test.mjs",
    "test:unreal-pacman-fixture": "node tests/unreal-pacman-fixture-contract-test.mjs",
    "generate:cymonkey-protocol": "node scripts/generate-cymonkey-protocol.mjs",
    "generate:pacman-protocol": "node scripts/generate-pacman-protocol.mjs",
    "check:cymonkey-protocol": "node scripts/generate-cymonkey-protocol.mjs --check",
    "check:pacman-protocol": "node scripts/generate-pacman-protocol.mjs --check"
  },
  "dependencies": {
    "playwright-core": "1.51.1",
    "puppeteer-core": "25.4.0",
    "three": "^0.185.1"
  }
}
