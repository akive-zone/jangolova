{
  "apiVersion": "jangolova.dev/v1alpha1",
  "kind": "Session",
  "metadata": {
    "name": "browser-session"
  },
  "spec": {
    "engine": {
      "adapter": "browser",
      "source": "https://example.com"
    },
    "surfaces": [
      {
        "name": "desktop",
        "adapter": "xvfb",
        "options": {
          "geometry": "1920x1080x24"
        }
      }
    ],
    "controllers": [
      {
        "name": "automation",
        "adapter": "puppeteer"
      }
    ],
    "connectors": [
      {
        "name": "remote-view",
        "adapter": "vnc",
        "surface": "desktop"
      }
    ]
  }
}
