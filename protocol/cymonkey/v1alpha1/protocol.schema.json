{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jangolova.dev/protocol/cymonkey/v1alpha1/protocol.schema.json",
  "title": "Jangolova Browser Extension Cymonkey subsystem protocol",
  "oneOf": [
    {"$ref": "#/$defs/hello"},
    {"$ref": "#/$defs/capability"},
    {"$ref": "#/$defs/action"},
    {"$ref": "#/$defs/eventBatch"}
  ],
  "$defs": {
    "backend": {"enum": ["cdp", "bidi", "safari-mcp", "webextension"]},
    "hello": {
      "type": "object",
      "required": ["protocolVersion", "implementation", "backends"],
      "properties": {
        "protocolVersion": {"const": "jangolova.cymonkey/v1alpha1"},
        "implementation": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string"}
          },
          "additionalProperties": false
        },
        "backends": {"type": "array", "items": {"$ref": "#/$defs/backend"}, "uniqueItems": true},
        "features": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "required": ["name", "backend", "support", "lifetime", "persistence", "effect", "inputSchema"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "backend": {"$ref": "#/$defs/backend"},
        "support": {"enum": ["native", "mapped", "emulated"]},
        "lifetime": {"enum": ["call", "document", "browser-session", "profile"]},
        "persistence": {"enum": ["ephemeral", "session", "persistent"]},
        "effect": {"enum": ["read", "write", "external"]},
        "inputSchema": {"type": "object"},
        "alternatives": {"type": "array", "items": {"$ref": "#/$defs/backend"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["name", "input"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "input": {"type": "object"}
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["id", "type", "occurredAt"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "occurredAt": {"type": "string", "format": "date-time"},
        "backend": {"$ref": "#/$defs/backend"},
        "data": {"type": "object"}
      },
      "additionalProperties": false
    },
    "eventBatch": {
      "type": "object",
      "required": ["events", "cursor"],
      "properties": {
        "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
        "cursor": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
