{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jangolova.dev/protocol/cymonkey/v1alpha1/augmentation.schema.json",
  "title": "Jangolova Browser Extension augmentation contract",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "jangolova.cymonkey/v1alpha1"},
    "kind": {"const": "Augmentation"},
    "metadata": {
      "type": "object",
      "required": ["id", "revision"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "revision": {"type": "string", "minLength": 1},
        "labels": {"type": "object", "additionalProperties": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["matches", "permissions"],
      "properties": {
        "matches": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "excludeMatches": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "permissions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "enabled": {"type": "boolean", "default": true},
        "scripts": {"type": "array", "items": {"$ref": "#/$defs/script"}},
        "styles": {"type": "array", "items": {"$ref": "#/$defs/style"}},
        "networkRules": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "script": {
      "type": "object",
      "required": ["id"],
      "oneOf": [{"required": ["source"]}, {"required": ["files"]}],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "source": {"type": "string"},
        "files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "world": {"enum": ["ISOLATED", "MAIN"]},
        "runAt": {"enum": ["document_start", "document_end", "document_idle"]},
        "allFrames": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "required": ["id", "css"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "css": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
