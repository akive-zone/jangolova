{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jangolova.dev/protocol/pacman/v1/protocol.schema.json",
  "title": "Pacman semantic presentation protocol",
  "description": "Transport-neutral messages for explicitly allowlisted presentation resources across Godot, Unity, Unreal, and Three.js.",
  "$defs": {
    "resourceKind": {
      "enum": ["scene", "object", "ui", "camera", "material", "animation", "timeline", "artifact", "event"]
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}:[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
    },
    "hello": {
      "type": "object",
      "required": ["protocolVersion", "implementation"],
      "properties": {
        "protocolVersion": {"const": "jangolova.pacman/v1alpha1"},
        "implementation": {
          "type": "object",
          "required": ["engine", "name"],
          "properties": {
            "engine": {"enum": ["godot", "unity", "unreal", "threejs"]},
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string"}
          },
          "additionalProperties": false
        },
        "features": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "required": ["name", "effect", "inputSchema"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "effect": {"enum": ["read", "write", "external"]},
        "targetKinds": {"type": "array", "items": {"$ref": "#/$defs/resourceKind"}, "uniqueItems": true},
        "inputSchema": {"type": "object"}
      },
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "kind": {"$ref": "#/$defs/resourceKind"},
        "label": {"type": "string"},
        "properties": {}
      },
      "additionalProperties": false
    },
    "description": {
      "type": "object",
      "required": ["revision", "resources"],
      "properties": {
        "revision": {"type": "string", "minLength": 1},
        "resources": {"type": "array", "items": {"$ref": "#/$defs/resource"}}
      },
      "additionalProperties": false
    },
    "health": {
      "type": "object",
      "required": ["status", "observedAt"],
      "properties": {
        "status": {"enum": ["ready", "degraded", "unavailable"]},
        "message": {"type": "string"},
        "observedAt": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  }
}
