{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jangolova.dev/protocol/grimlock/v1/model-profile.schema.json",
  "title": "Caller-supplied agent model profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "profileId", "protocol", "endpoint", "model", "credentialRef"],
  "properties": {
    "apiVersion": {"const": "agent.model/v1alpha1"},
    "profileId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
    },
    "protocol": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,63}$"
    },
    "endpoint": {
      "type": "string",
      "format": "uri",
      "maxLength": 4096
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "roles": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {"enum": ["reasoning", "vision", "multimodal"]}
    },
    "credentialRef": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
    },
    "tlsRef": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
    },
    "metadata": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 1024
      }
    }
  }
}
